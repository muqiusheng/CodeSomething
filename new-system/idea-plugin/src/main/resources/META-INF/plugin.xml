<idea-plugin>
    <id>dev.codesomething.idea</id>
    <name>Maqibu</name>
    <version>0.3.2</version>
    <resource-bundle>messages.MaqibuBundle</resource-bundle>
    <idea-version since-build="262" until-build="262.*"/>
    <vendor>Maqibu</vendor>
    <description><![CDATA[
        Maqibu connects IntelliJ IDEA projects to local lessons, checks, and reports.可在 IDEA 中配对、提交、检查和恢复作业，并在网页继续理解验证。
    ]]></description>
    <depends>com.intellij.modules.platform</depends>
    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="CodeSomething" anchor="right" factoryClass="dev.codesomething.idea.LearningToolWindowFactory"/>
    </extensions>
</idea-plugin>
