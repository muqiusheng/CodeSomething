# Install in the dedicated deployment user's crontab. Times use the host timezone.
0 3 * * * . /srv/codesomething/maintenance.env && /bin/sh /srv/codesomething/repo/new-system/deployment/maintenance.sh backup
30 4 * * * . /srv/codesomething/maintenance.env && /bin/sh /srv/codesomething/repo/new-system/deployment/maintenance.sh cleanup
