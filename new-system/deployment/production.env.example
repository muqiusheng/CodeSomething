# Use a dedicated Linux machine with a rootless Docker daemon and delegated cgroup v2 controllers.
CS_PUBLIC_HOST=learn.example.org
# Set to 1 only at the Instabox origin serving try.maqibu.online through its gateway.
CS_ALLOW_INDEXING=0
CS_BIND_ADDRESS=127.0.0.1
CS_PROD_DATA_DIRECTORY=/srv/codesomething/data
CS_TLS_DIRECTORY=/srv/codesomething/tls
CS_RUNNER_DOCKER_SOCKET=/run/user/1000/docker.sock
# Both these values must come from a private environment file. Generate CS_JWT_SECRET with openssl rand -base64 32.
CS_JWT_SECRET=
CS_INITIAL_ADMIN_PASSWORD=
CS_INVITE_REQUIRED=true
CS_PUBLIC_MYSQL_POOL_LIMIT=2
CS_PUBLIC_TUTOR_ENABLED=false
