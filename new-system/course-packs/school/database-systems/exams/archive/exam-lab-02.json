      "referenceSql": "CREATE TABLE credit_plan (Cno CHAR(3) PRIMARY KEY,Credit TINYINT NOT NULL CHECK(Credit BETWEEN 1 AND 6)); INSERT INTO credit_plan VALUES ('006',5);",
