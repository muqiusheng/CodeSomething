    "**/.npm-cache": true,
    "**/target": true,
    "**/dist": true,
    "**/*.tsbuildinfo": true,
    ".cache": true,
    "new-system/runtime": true,
    "new-system/idea-plugin/build": true,
    "new-system/idea-plugin/.gradle": true,
    "new-system/idea-plugin/.intellijPlatform": true
